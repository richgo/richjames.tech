# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# LinkedIn cookies
.linkedin-cookies.json

# Dotfiles and dot-directories at any depth
.*
!.gitignore

# Playwright evidence is generated locally.
/test-results/

# APMX stages a plain tree and honors .gitignore.
!.forge/
!.forge/verify-change
!.forge/sagekit.json
!.forge/seed-sagekit.py
!.forge/probe-sagekit.py
!/.forge/openspec.json
!/openspec/changes/*/.openspec.yaml

# APMX 0.8.0 rejects bracketed paths when exporting its plain-tree capture.
# These files stay tracked. The checker restores them from the exact run commit.
/src/app/blog/\[slug\]/BlogPostClient.tsx
/src/app/blog/\[slug\]/page.tsx
/src/app/tags/\[tag\]/TagPageClient.tsx
/src/app/tags/\[tag\]/page.tsx
